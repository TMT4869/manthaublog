# API Gateway
PORT=8080
JWT_JWKS_URI=http://auth-service:8081/.well-known/jwks.json

# Redis
REDIS_ADDR=redis:6379

# Downstream Services
AUTH_SERVICE_URL=http://auth-service:8081
USER_SERVICE_URL=http://user-service:8082
POST_SERVICE_URL=http://post-service:8083
COMMENT_SERVICE_URL=http://comment-service:8084
SEARCH_SERVICE_URL=http://search-service:8085
NOTIFICATION_SERVICE_URL=http://notification-service:8086
ANALYTICS_SERVICE_URL=http://analytics-service:8087
MEDIA_SERVICE_URL=http://media-service:8088
